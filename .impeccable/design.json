  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A compact primary action using the existing semantic theme.",
      "html": "<button class=\"ds-primary\">Сохранить</button>",
      "css": ".ds-primary{font-family:var(--font,Roboto,sans-serif);font-size:13px;font-weight:500;line-height:1.4;min-height:38px;padding:8px 14px;border-radius:7px;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,box-shadow 140ms ease;background:var(--primary-color,#568d2d);color:var(--button-color,#fff);border:1px solid var(--primary-color,#568d2d)}.ds-primary:hover:not(:disabled){background:var(--primary-color-hover,#477825);border-color:var(--primary-color-hover,#477825)}.ds-primary:focus-visible{outline:2px solid var(--primary-color,#568d2d);outline-offset:3px;box-shadow:none;}.ds-primary:disabled{filter:opacity(.5);cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A secondary action with a thin field border.",
      "html": "<button class=\"ds-secondary\">Отмена</button>",
      "css": ".ds-secondary{font-family:var(--font,Roboto,sans-serif);font-size:13px;font-weight:500;line-height:1.4;min-height:38px;padding:8px 14px;border-radius:7px;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,box-shadow 140ms ease;background:var(--content-background,#fff);color:var(--text-color,#243029);border:1px solid var(--input-border-color,#d8e2d2)}.ds-secondary:hover:not(:disabled){background:var(--background-accent-color-hover,#f8faf6);color:var(--primary-color-hover,#477825);border-color:var(--primary-color-hover,#477825)}.ds-secondary:focus-visible{outline:2px solid var(--primary-color,#568d2d);outline-offset:3px;box-shadow:none;}.ds-secondary:disabled{filter:opacity(.5);cursor:default}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "The shared medium field, including focus and native error/disabled states.",
      "html": "<label class=\"ds-field\">Название<input class=\"ds-input\" value=\"Контроллер\" /></label>",
      "css": ".ds-field{display:grid;gap:7px;color:var(--text-color,#243029);font:500 13px/1.45 var(--font,Roboto,sans-serif)}.ds-input{height:38px;padding:8px 11px;background:var(--content-background,#fff);color:var(--text-color,#243029);border:1px solid var(--input-border-color,#d8e2d2);border-radius:7px;font:400 13px var(--font,Roboto,sans-serif);transition:border-color 140ms ease,box-shadow 140ms ease}.ds-input:focus{outline:none;border-color:var(--primary-color,#568d2d);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary-color,#568d2d) 12%,transparent)}.ds-input[aria-invalid=\"true\"]{border-color:var(--danger-color,#dc3545)}.ds-input:disabled{background:var(--background-accent-color-hover,#f8faf6);color:var(--gray-color,#67736b)}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
      "name": "Navigation Item",
      "kind": "nav",
      "refersTo": "navigation-item-active",
      "description": "The selected row in the persistent dark shell.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#/overview\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"13\" rx=\"1\"/><path d=\"M8 21h8M12 17v4\"/></svg>Обзор</a></nav>",
      "css": ".ds-nav{background:var(--nav-bg,#202722);padding:14px;max-width:232px}.ds-nav-item{display:flex;gap:12px;align-items:center;min-height:43px;padding:12px;border-radius:7px;background:var(--nav-item-active,#384c2e);color:#e1f4ce;font:400 13px/1.45 var(--font,Roboto,sans-serif);text-decoration:none}.ds-nav-item svg{width:19px;height:19px;fill:none;stroke:#a8d87c;stroke-width:1.5}.ds-nav-item:hover{background:var(--nav-item-hover,#303c2d);color:#fff}.ds-nav-item:focus-visible{outline:3px solid #82b85a;outline-offset:3px}"
    },
